    <property name="styleSheet">
      <string>QWidget { font-family: "Segoe UI"; font-size: 13px; color: black; }
QWidget#centralwidget { background: #f3eff9; }
QPushButton { background: #e2d8f2; color: black; border: 1px solid #bba7d5; border-radius: 5px; padding: 4px; }
QPushButton:hover { background: #d4c3eb; }
QLineEdit, QComboBox, QDateEdit, QTextEdit { background: white; color: black; border: 1px solid #c5bbd2; border-radius: 3px; padding: 3px; }
QLineEdit:focus { border: 1px solid #8055ac; }
QLineEdit[invalid="true"] { border: 1px solid #c0394f; background: #fff2f3; }
QComboBox QAbstractItemView, QTableView { background: white; color: black; selection-background-color: #e2d8f2; selection-color: black; }
QHeaderView::section { background: #e9e0f4; color: black; padding: 6px; border: 1px solid #d3c6e2; }
QDialog, QMessageBox { background: #f3eff9; color: black; }
QMessageBox QLabel, QMessageBox QPushButton, QMessageBox QTextEdit { color: black; }</string>
